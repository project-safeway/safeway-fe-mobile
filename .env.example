# Copie para .env e preencha.
# Chave restrita a "Android apps" (pacote com.safeway.mobile + SHA-1 da assinatura),
# com "Maps SDK for Android" e "Routes API" ativados e liberados na chave.
GOOGLE_MAPS_API_KEY=

# SHA-1 do keystore usado no build (eas credentials). Com ou sem ":".
# A Routes API exige esse valor no header X-Android-Cert quando a chave é restrita a Android.
GOOGLE_ANDROID_CERT_SHA1=

# Endereço da API Python do assistente (ex.: http://192.168.0.10:8000).
# Vazio: o assistente responde com o mock local.
IA_API_URL=
